DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/eyesschool
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development

# "production" hace que la API no arranque sin una SECRET_KEY propia.
# Orígenes del navegador permitidos, separados por coma ("*" = cualquiera).
CORS_ORIGINS=*

# Notificaciones push (Firebase). JSON completo de la cuenta de servicio; solo en Azure,
# nunca en el repositorio. Vacío = la API guarda las novedades pero no envía push.
FIREBASE_CREDENTIALS_JSON=
