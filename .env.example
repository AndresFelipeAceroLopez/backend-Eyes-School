DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/eyesschool
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development

# "production" hace que la API no arranque sin una SECRET_KEY propia.
# Orígenes del navegador permitidos, separados por coma ("*" = cualquiera).
CORS_ORIGINS=*
