# Plantilla de variables para CORRER PRUEBAS. Copie a `.env.test` y llene los valores.
# `.env.test` está ignorado por git (.gitignore: `.env.*`); solo este `.example` se versiona.
#
# IMPORTANTE: la aplicación NO lee este archivo. `app/core/config.py` lee `.env`, que apunta a
# PRODUCCIÓN. Las pruebas y los scripts de QA leen estas variables del SHELL, así que hay que
# cargarlas en la terminal antes de correrlas:
#
#   Git Bash:    set -a; source .env.test; set +a
#   PowerShell:  Get-Content .env.test | ForEach-Object {
#                  if ($_ -match '^\s*([A-Z_]+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2]) } }
#
# Las unitarias (`pytest`) no necesitan ninguna de estas: `tests/conftest.py` fuerza
# `DATABASE_URL` a una dirección inexistente antes de importar la app.


# ─── Pruebas de integración contra PostgreSQL (PR-05, BE-INF-1) ───────────────────────
# Base DESECHABLE. La suite BORRA Y RECREA el esquema: nunca apunte esto a QA ni a producción.
# Si la variable no está definida, las 53 pruebas de integración se OMITEN en silencio.
# Levante la base con Docker:
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=test -e POSTGRES_DB=eyes_test postgres:18
# o con el zip de binarios de PostgreSQL 18 (ver docs/test/Integracion).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:test@localhost:5432/eyes_test


# ─── Pruebas E2E contra la API de QA: Newman, schemathesis y k6 (PR-05 y PR-06) ────────
# URL de la API de QA, con el prefijo /api/v1 incluido. Es pública, no es un secreto.
# Azure → Web App `apieyeschool-q` → Overview → Default domain.
QA_API=https://apieyeschool-q-g4hfgrgvepbecacc.chilecentral-01.azurewebsites.net/api/v1

# Contraseña común de los usuarios de QA, la que fija `scripts/qa_reset_passwords.py`.
# ES UN SECRETO: no la escriba en este archivo si lo va a compartir, y nunca en un commit,
# en una captura ni en las evidencias. Debe cumplir la política de BE-09.
QA_PASSWORD=

# Correo del docente de QA (DS-01) que usan los escenarios de carga de k6.
QA_DOCENTE=

# Id de un estudiante de QA para registrar asistencia de tipo `clase` en las pruebas de carga.
QA_ID_ESTUDIANTE_CLASE=

# Access token de un admin, solo para schemathesis. Caduca en 30 minutos: se genera al momento
# con un login y no se guarda aquí.
TOKEN_ADMIN=
